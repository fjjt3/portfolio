---
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';
import { locales } from '../i18n';

const cvPath = path.resolve(process.cwd(), 'docs/cv.md');
const raw = fs.readFileSync(cvPath, 'utf-8');
const { data: meta } = matter(raw);
---

<section
  class="relative flex min-h-screen items-center justify-center overflow-hidden px-4 py-28 sm:px-6"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgba(99,102,241,0.15),transparent)]"
  >
  </div>
  <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="terminal-window relative z-10 mx-auto w-full max-w-5xl">
    <div
      class="flex h-12 items-center justify-between border-b border-zinc-800 px-4 sm:px-6"
      aria-hidden="true"
    >
      <div class="flex items-center gap-2">
        <span class="h-2.5 w-2.5 bg-zinc-600"></span>
        <span class="h-2.5 w-2.5 bg-zinc-600"></span>
        <span class="h-2.5 w-2.5 bg-indigo-400"></span>
      </div>
      <span class="font-mono text-[10px] tracking-[0.16em] text-zinc-500 sm:text-xs">
        FJ-01 / PORTFOLIO.SYS
      </span>
      <span class="font-mono text-[10px] text-zinc-600 sm:text-xs">TTY 01</span>
    </div>

    <div class="px-5 py-9 sm:px-10 sm:py-12 lg:px-14 lg:py-14">
    <p class="hero-kicker mb-7 flex items-center gap-3 font-mono text-xs text-zinc-400 sm:text-sm">
      <span class="h-2 w-2 shrink-0 rounded-full bg-indigo-400" aria-hidden="true"></span>
      <span data-i18n="heroKicker">{locales.en.hero.kicker}</span>
    </p>

    <h1
      class="max-w-4xl break-words font-mono text-3xl font-medium leading-[1.2] tracking-[-0.06em] text-zinc-100 sm:text-4xl md:text-5xl lg:text-6xl"
    >
      <span class="mr-2 text-indigo-400" aria-hidden="true">&gt;</span><span data-i18n="heroHeading">{locales.en.hero.heading}</span>
    </h1>

    <p class="mt-7 max-w-2xl text-base leading-relaxed text-zinc-400 sm:text-lg">
      <span data-i18n="heroDescription">{locales.en.hero.description}</span>
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-3 sm:gap-4">
      <a
        href="#cv"
        class="inline-flex items-center gap-2 rounded-sm bg-indigo-500 px-6 py-3 font-mono text-sm font-medium text-white transition-colors hover:bg-indigo-400"
      >
        <span data-i18n="heroViewCv">{locales.en.hero.viewCv}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z"
            clip-rule="evenodd"></path>
        </svg>
      </a>

      <a
        href={meta.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-sm border border-zinc-700 px-6 py-3 font-mono text-sm font-medium text-zinc-300 transition-colors hover:border-zinc-500 hover:text-zinc-100"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
        GitHub
      </a>

      <a
        href={meta.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-sm border border-zinc-700 px-6 py-3 font-mono text-sm font-medium text-zinc-300 transition-colors hover:border-zinc-500 hover:text-zinc-100"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
        LinkedIn
      </a>
    </div>
    </div>
  </div>
</section>

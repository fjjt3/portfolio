---
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';

const cvPath = path.resolve(process.cwd(), 'docs/cv.md');
const raw = fs.readFileSync(cvPath, 'utf-8');
const { data: meta } = matter(raw);

const links = [
  { label: 'Inicio', href: '#' },
  { label: 'CV', href: '#cv' },
  { label: 'Proyectos', href: meta.github, external: true },
];
---

<nav
  class="fixed top-0 left-0 right-0 z-50 border-b border-zinc-800/50 bg-zinc-950/80 backdrop-blur-xl"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="text-lg font-bold tracking-tight text-zinc-100">
      Francisco<span class="text-indigo-400">.</span>
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            class="text-sm text-zinc-400 transition-colors hover:text-zinc-100"
          >
            {link.label}
            {link.external && (
              <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 inline h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
                <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
              </svg>
            )}
          </a>
        </li>
      ))}
    </ul>

    <button
      id="menu-toggle"
      class="flex flex-col gap-1.5 md:hidden"
      aria-label="Abrir menú"
    >
      <span class="block h-0.5 w-6 bg-zinc-300 transition-all" id="bar1"></span>
      <span class="block h-0.5 w-6 bg-zinc-300 transition-all" id="bar2"></span>
      <span class="block h-0.5 w-6 bg-zinc-300 transition-all" id="bar3"></span>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-zinc-800/50 md:hidden">
    <ul class="flex flex-col gap-1 px-6 py-4">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            class="block py-2 text-sm text-zinc-400 transition-colors hover:text-zinc-100"
          >
            {link.label}
            {link.external && (
              <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 inline h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
                <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
              </svg>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const bar1 = document.getElementById('bar1')!;
  const bar2 = document.getElementById('bar2')!;
  const bar3 = document.getElementById('bar3')!;

  toggle.addEventListener('click', () => {
    const isOpen = !menu.classList.contains('hidden');
    menu.classList.toggle('hidden');
    bar1.classList.toggle('rotate-45');
    bar1.classList.toggle('translate-y-2');
    bar2.classList.toggle('opacity-0');
    bar3.classList.toggle('-rotate-45');
    bar3.classList.toggle('-translate-y-2');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
